---
import { TRUSTED_MARQUEE_LENDERS } from '../lib/trustedMarqueeLenders';

const lenders = TRUSTED_MARQUEE_LENDERS.map((l) => ({ name: l.name, src: l.logoSrc }));
---

<section
	class="relative border-b border-brand/10 bg-page py-16 sm:py-24"
	style="background-image: radial-gradient(rgba(22, 101, 52, 0.08) 1px, transparent 1px); background-size: 20px 20px;"
	aria-labelledby="trusted-lenders-heading"
>
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2
			id="trusted-lenders-heading"
			class="font-display mx-auto max-w-4xl text-center text-3xl font-bold tracking-tight text-brand sm:text-4xl"
		>
			<span class="block">Some of the trusted lenders</span>
			<span class="mt-2 block sm:mt-3">we work with</span>
		</h2>

		<p class="mx-auto mt-4 max-w-2xl text-center text-lg text-fg-muted">
			Major banks, regional banks, and specialist business lenders — shown for illustration; actual availability depends on your scenario.
		</p>

		<div class="relative mt-12">
			<div
				class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-page to-transparent sm:w-20"
				aria-hidden="true"
			/>
			<div
				class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-page to-transparent sm:w-20"
				aria-hidden="true"
			/>
			<div class="overflow-hidden py-2">
				<div class="trusted-marquee-track">
					<div class="trusted-marquee-set flex shrink-0 items-center gap-10 pr-10 sm:gap-14 sm:pr-14 md:gap-16">
						{
							lenders.map((l) => (
								<img
									src={l.src}
									alt={l.name}
									width="160"
									height="64"
									loading="lazy"
									decoding="async"
									draggable="false"
									class="h-11 w-auto max-w-[9rem] shrink-0 object-contain object-center sm:h-12 md:h-14"
								/>
							))
						}
					</div>
					<div
						class="trusted-marquee-set trusted-marquee-dupe flex shrink-0 items-center gap-10 pr-10 sm:gap-14 sm:pr-14 md:gap-16"
						aria-hidden="true"
					>
						{
							lenders.map((l) => (
								<img
									src={l.src}
									alt=""
									width="160"
									height="64"
									loading="lazy"
									decoding="async"
									draggable="false"
									class="h-11 w-auto max-w-[9rem] shrink-0 object-contain object-center sm:h-12 md:h-14"
								/>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
