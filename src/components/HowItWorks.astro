---
import { parseStructuredText } from '../lib/textFormat';

const steps = [
	{
		icon: 'survey' as const,
		title: 'Kick Things Off by Quick 50 seconds enquiry',
		body: `• Super quick & easy
• No paperwork headaches
• No obligation to proceed

Just share a few details about your business, and we’ll take it from there.`,
	},
	{
		icon: 'phone' as const,
		title: 'Let’s Talk',
		body: `Our Team will connect you to:
• Understand your business goals
• Walk you through possible options
• Answer all your questions

Think of us as your finance support partner, not just a service.`,
	},
	{
		icon: 'compare' as const,
		title: 'Get Tailored Options',
		body: `We match you with lenders who may suit your needs and bring you customised funding options.
• Clear & transparent
• No pressure decisions
• Options that fit your business

You stay in control – choose what works best for you.`,
	},
	{
		icon: 'grow' as const,
		title: 'Move Ahead & Grow',
		body: 'Happy with an option? Move forward and take the next step towards growing your business with confidence.',
	},
];
---

<section
	id="how"
	class="scroll-mt-20 border-b border-brand/10 bg-gradient-to-b from-page to-surface-subtle py-20 sm:py-28"
>
	<div class="mx-auto max-w-6xl px-4 sm:px-6">
		<h2 class="font-display text-center text-3xl font-bold tracking-tight text-brand sm:text-4xl">
			How it works
		</h2>
		<p class="mx-auto mt-4 max-w-2xl text-center text-lg text-fg-muted">
			A straight path from enquiry to clarity—without drowning in paperwork first.
		</p>

		<div class="mx-auto mt-14 flex max-w-6xl flex-col gap-3 xl:flex-row xl:items-stretch xl:justify-center xl:gap-0" role="list">
			{
				steps.map((s, i) => (
					<>
					<div
						class="w-full rounded-2xl border border-brand/15 bg-surface p-5 shadow-md shadow-brand/5 sm:p-6 xl:w-[242px] xl:aspect-square xl:p-5"
						role="listitem"
					>
							<div class="flex items-center gap-3">
								<div
									class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"
									aria-hidden="true"
								>
									{s.icon === 'survey' && (
										<svg
											class="h-6 w-6"
											xmlns="http://www.w3.org/2000/svg"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.065 4.072 8.25 4.992 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"
											/>
										</svg>
									)}
									{s.icon === 'phone' && (
										<svg
											class="h-6 w-6"
											xmlns="http://www.w3.org/2000/svg"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
											/>
										</svg>
									)}
									{s.icon === 'compare' && (
										<svg
											class="h-6 w-6"
											xmlns="http://www.w3.org/2000/svg"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"
											/>
										</svg>
									)}
									{s.icon === 'grow' && (
										<svg
											class="h-6 w-6"
											xmlns="http://www.w3.org/2000/svg"
											fill="none"
											viewBox="0 0 24 24"
											stroke-width="1.5"
											stroke="currentColor"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zm11.06-11.06l3.75 3.75M14.25 4.5h6.75v6.75"
											/>
										</svg>
									)}
								</div>
							</div>
							<h3 class="mt-3.5 font-display text-[0.95rem] font-semibold leading-snug text-fg sm:text-base">
								{s.title}
							</h3>
							<div class="mt-2 space-y-2 text-[0.78rem] leading-relaxed text-fg-muted sm:text-[0.67rem]">
								{
									parseStructuredText(s.body).map((block) =>
										block.kind === 'list' ? (
											<ul class="list-disc space-y-1 pl-4.5 marker:text-brand-secondary">
												{block.items.map((item) => <li>{item}</li>)}
											</ul>
										) : (
											<p class={block.emphasize ? 'font-semibold text-fg' : ''}>{block.text}</p>
										),
									)
								}
							</div>
					</div>
					{i < steps.length - 1 && (
						<div
							class="flex shrink-0 items-center justify-center py-1 xl:px-3 xl:py-0"
							aria-hidden="true"
						>
							<svg
								class="h-8 w-8 rotate-90 text-brand-secondary xl:h-9 xl:w-9 xl:rotate-0"
								xmlns="http://www.w3.org/2000/svg"
								fill="none"
								viewBox="0 0 24 24"
								stroke-width="1.5"
								stroke="currentColor"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
								/>
							</svg>
						</div>
					)}
					</>
				))
			}
		</div>
	</div>
</section>
