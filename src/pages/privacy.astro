---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import privacyPolicyHtml from '../content/legal/privacy-policy.html?raw';

export const prerender = true;
---

<Layout title="Privacy policy — QuickBiz" description="QuickBiz privacy policy.">
	<Header />
	<main>
		<section class="border-b border-brand/10 bg-gradient-to-b from-page to-surface-subtle py-10 sm:py-14 lg:py-12">
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="mx-auto max-w-4xl lg:max-w-5xl" set:html={privacyPolicyHtml} />
			</div>
		</section>
	</main>
	<Footer />
</Layout>
