---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getProductBySlug, products } from '../../lib/products';
import { parseStructuredText } from '../../lib/textFormat';

export const prerender = true;

export function getStaticPaths() {
	return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
if (slug === 'business-bridging-finance') {
	return Astro.redirect('/products/business-equity-finance', 301);
}
const product = slug ? getProductBySlug(slug) : undefined;
if (!product) {
	return Astro.redirect('/');
}

const pageTitle = `${product.title} — QuickBiz`;
const productBlocks = parseStructuredText(product.summary);
---

<Layout title={pageTitle} description={`${product.title} — QuickBiz.`}>
	<Header />
	<main>
		<section class="border-b border-brand/10 bg-gradient-to-b from-page to-surface-subtle py-16 sm:py-24">
			<div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
				<p class="text-sm font-medium text-brand-secondary">
					<a href="/#products" class="transition hover:text-brand">← Products</a>
				</p>
				<h1 class="mt-4 font-display text-3xl font-bold tracking-tight text-brand sm:text-4xl">
					{product.title}
				</h1>
				<div class="mx-auto mt-6 max-w-2xl space-y-4 text-left text-fg-muted leading-relaxed">
					{
						productBlocks.map((block) =>
							block.kind === 'list' ? (
								<ul class="list-disc space-y-1.5 pl-5 marker:text-brand-secondary">
									{block.items.map((item) => <li>{item}</li>)}
								</ul>
							) : (
								<p class={block.emphasize ? 'font-semibold text-fg' : ''}>{block.text}</p>
							),
						)
					}
				</div>
				<p class="mt-8">
					<a
						href="/#check-eligibility"
						class="inline-flex rounded-full bg-cta px-6 py-3 text-sm font-semibold text-white shadow-md shadow-brand/25 transition hover:brightness-110"
					>
						Check eligibility
					</a>
				</p>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
