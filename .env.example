# Copy to .env and fill. Never commit .env.

# Server-only — never prefix with PUBLIC_ (keeps secrets out of the browser bundle).

# ABR XML search authentication GUID
ABR_GUID=

# Supabase (production + optional local) — eligibility questionnaire
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (Resend) — lead notifications + questionnaire Excel export
RESEND_API_KEY=

# Oracle (optional local dev fallback if Supabase is not set)
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=
ORACLE_USER=
ORACLE_PASSWORD=

OTP_EXPOSE_CODE=false
